{
  "api_sources": {
    "arxiv": {
      "enabled": true,
      "categories": ["cs.LG", "cs.AI", "cs.CL", "cs.CV", "cs.CR", "cs.DC", "cs.SE", "cs.PL", "cs.DB", "stat.ML"],
      "max_results": 50,
      "sort_by": "submittedDate"
    },
    "semantic_scholar": {
      "enabled": true,
      "queries": [
        "machine learning",
        "deep learning",
        "natural language processing",
        "computer vision",
        "software engineering",
        "neural networks",
        "reinforcement learning",
        "transformer models"
      ],
      "max_results_per_query": 10,
      "fields": "title,abstract,authors,year,venue,citationCount,externalIds,url,publicationDate,openAccessPdf"
    },
    "openalex": {
      "enabled": true,
      "search_terms": [
        "artificial intelligence",
        "machine learning",
        "deep learning",
        "software engineering",
        "NLP",
        "computer vision",
        "neural network"
      ],
      "max_results_per_term": 10,
      "from_date_days_ago": 7,
      "filter_type": "article"
    },
    "crossref": {
      "enabled": true,
      "query": "artificial intelligence OR machine learning OR deep learning OR software engineering OR NLP OR computer vision",
      "max_results": 30,
      "days_ago": 7
    },
    "dblp": {
      "enabled": true,
      "streams": [
        "conf/nips",
        "conf/icml",
        "conf/iclr",
        "conf/aaai",
        "conf/cvpr",
        "conf/iccv",
        "conf/eccv",
        "conf/acl",
