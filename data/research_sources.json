    "papers_with_code": {
      "enabled": true,
      "tasks": ["image-classification", "object-detection", "text-classification", "machine-translation", "code-generation", "software-defect-detection"],
      "max_results_per_task": 5
    },
    "openreview": {
      "enabled": true,
      "venues": ["NeurIPS", "ICML", "ICLR", "AAAI", "CVPR", "ACL"],
